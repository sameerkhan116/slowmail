# Names only. Real values live in Supabase secrets and never in this repo.
#
#   supabase secrets set --env-file supabase/.env.local
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions by
# the platform; they are listed here so local `supabase functions serve` runs
# have the same shape. The service_role key is a server-only credential: it is
# read by the two postal workers and must never reach an app build, a client
# bundle, or a browser.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# APNs token-based auth (a .p8 key from the Apple Developer portal).
# APNS_PRIVATE_KEY is the full PEM including the BEGIN/END lines; keep the
# newlines, or set it with `supabase secrets set --env-file` which preserves them.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# "sandbox" for development builds, "production" for TestFlight and the App Store.
APNS_ENVIRONMENT=sandbox
